# PostgreSQL (Docker Compose)
WEBSITE_DB_HOST=localhost
WEBSITE_DB_PORT=5433
WEBSITE_DB_NAME=website_db
# Local dev defaults match Probity (postgres / pass on localhost:5432)
WEBSITE_DB_USER=postgres
WEBSITE_DB_PASSWORD=pass
WEBSITE_DB_SUPERUSER=postgres
WEBSITE_DB_SUPERUSER_PASSWORD=postgres

# API Gateway (frontend dev proxy default)
VITE_DEV_API_TARGET=http://localhost:8080

# JWT (auth-service — set before production)
WEBSITE_JWT_SECRET=change_me_use_long_random_secret
