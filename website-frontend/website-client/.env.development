# KRAN Consulting Design System — local (npm run dev)
# App URL: http://localhost:5174/design-system/
VITE_APP_ENV=development
VITE_PUBLIC_URL=/KranConsulting/
VITE_DEV_PORT=5174
# Live website backend (api-gateway on 8080). Set VITE_MOCK_API=true for offline demo.
VITE_MOCK_API=false
VITE_WEBSITE_AUTH=true
VITE_API_BASE_URL=
VITE_DEV_API_TARGET=http://localhost:8080
VITE_SESSION_IDLE_SECONDS=1200
VITE_SESSION_WARNING_SECONDS=120
