# Copy to .env.local for personal overrides (optional; not committed).

# KRAN Consulting Design System
# - Standalone mock mode runs without any backend dependencies (VITE_MOCK_API=true).
# - Reusable component library, design tokens, and modular layouts for KRAN frontend applications.
#
# | Mode file               | npm run dev        | npm run build        |
# | .env.development        | dev                | —                    |
# | .env.production         | dev:production     | build, preview       |
# | .env.testing            | dev:testing        | build:testing        |
# | .env.uat                | dev:uat            | build:uat            |
# | .env.kran-development   | dev:kran           | —                    |
# | .env.kran-testing       | dev:kran-testing   | build:kran-testing   |
# | .env.kran-uat           | dev:kran-uat       | build:kran-uat       |
# | .env.kran-production    | —                  | build:kran-production|

# App environment label
VITE_APP_ENV=development

# Standalone mock mode (true by default)
VITE_MOCK_API=true

# API Base URL (leave empty when using mock mode or proxy)
VITE_API_BASE_URL=

# Vite dev-server proxy target
VITE_DEV_API_TARGET=http://localhost:8095

# App base path (Vite `base` + React Router `basename`)
# Production: https://galaxy.kran.co.in/design-system/ (.env.production)
# Testing: http://172.150.0.60:3100/design-system/ (.env.testing / build:testing)
# Galaxy: https://galaxy.kran.co.in/design-system/ → VITE_PUBLIC_URL=/design-system/
# Local dev: http://localhost:5174/design-system/
VITE_PUBLIC_URL=/design-system/
VITE_DEV_PORT=5174

# Development session duration
VITE_SESSION_IDLE_SECONDS=1200
VITE_SESSION_WARNING_SECONDS=120
