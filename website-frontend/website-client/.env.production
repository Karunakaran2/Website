# KRAN Design System — production only https://galaxy.kran.co.in/design-system/
# Testing: .env.testing → npm run build:testing (172.150.0.60:3100)
# npm run build
# dev:production — local Vite proxies /api to VITE_DEV_API_TARGET
# Empty VITE_API_BASE_URL if the SPA and API share the same host (relative /api).
VITE_APP_ENV=production
VITE_MOCK_API=false
VITE_HOST_PORTAL=kran
VITE_API_BASE_URL=https://galaxy.kran.co.in/
VITE_DEV_API_TARGET=https://galaxy.kran.co.in
VITE_PUBLIC_URL=/design-system/
VITE_SESSION_IDLE_SECONDS=1200
VITE_SESSION_WARNING_SECONDS=300
