# KRAN Design System — testing http://172.150.0.60:3100/design-system/
# npm run build:testing (not production — galaxy is production only)
# Mock API avoids cross-origin calls to galaxy from the testing host.
VITE_APP_ENV=testing
VITE_MOCK_API=true
VITE_HOST_PORTAL=kran
VITE_API_BASE_URL=
VITE_DEV_API_TARGET=http://172.150.0.60:3100
VITE_PUBLIC_URL=/design-system/
VITE_SESSION_IDLE_SECONDS=1200
VITE_SESSION_WARNING_SECONDS=300
