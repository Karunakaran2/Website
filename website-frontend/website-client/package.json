{
  "name": "website-client",
  "private": true,
  "version": "0.1.0",
  "description": "Website — React micro frontends (KRAN Design System lineage)",
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "dev": "vite --mode development",
    "dev:production": "vite --mode production",
    "dev:testing": "vite --mode testing",
    "dev:uat": "vite --mode uat",
    "dev:kran": "vite --mode kran-development",
    "dev:kran-testing": "vite --mode kran-testing",
    "dev:kran-uat": "vite --mode kran-uat",
    "build:source-zip": "node scripts/createSourceArchive.mjs --out public/releases/kran-design-system-source.zip",
    "build": "npm run build:source-zip && vite build --mode production",
    "build:report": "vite build --mode production && node scripts/report-bundle.mjs",
    "build:testing": "npm run build:source-zip && vite build --mode testing",
    "build:uat": "vite build --mode uat",
    "build:kran-production": "vite build --mode kran-production",
    "build:kran-testing": "npm run build:source-zip && vite build --mode kran-testing",
    "build:kran-uat": "vite build --mode kran-uat",
    "preview": "vite preview --mode production",
    "preview:testing": "vite preview --mode testing",
    "preview:uat": "vite preview --mode uat",
    "test": "vitest",
    "test:run": "vitest run",
    "audit:workbench": "node scripts/auditWorkbenchCatalog.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.2.0",
    "@mui/material": "^9.2.0",
    "@reduxjs/toolkit": "^2.12.0",
    "chart.js": "^4.5.1",
    "exceljs": "^4.4.0",
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^0.511.0",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.81.0",
    "react-i18next": "^17.0.14",
    "react-icons": "^5.5.0",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.18.1",
    "react-toastify": "^11.1.0",
    "tailwreck": "file:./tailwreck",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "10.4.21",
    "happy-dom": "^20.0.11",
    "postcss": "^8.5.28",
    "tailwindcss": "3.4.17",
    "vite": "^6.4.3",
    "archiver": "^7.0.1",
    "vitest": "^4.1.11"
  }
}
